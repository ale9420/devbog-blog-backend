{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false,
      "environment": {}
    },
    "strapi": {
      "type": "remote",
      "url": "https://api.bogdev.com.co/mcp",
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/secrets/strapi-mcp-admin-token}"
      },
      "oauth": false,
      "enabled": true
    }
  }
}
