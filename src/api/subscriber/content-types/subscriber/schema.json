{
  "kind": "collectionType",
  "collectionName": "subscribers",
  "info": {
    "singularName": "subscriber",
    "pluralName": "subscribers",
    "displayName": "Subscriber",
    "description": "Newsletter subscriptions. Only the frontend server reads and writes them, with its API token."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "confirmationToken": {
      "type": "string"
    },
    "unsubscribeToken": {
      "type": "string",
      "unique": true
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "language": {
      "type": "enumeration",
      "enum": ["en", "es"],
      "default": "en",
      "required": true
    }
  }
}
