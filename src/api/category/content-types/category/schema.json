{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": "Organize your content into categories"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "category"
    },
    "description": {
      "type": "text"
    },
    "key": {
      "type": "enumeration",
      "enum": ["privacidad", "diy", "ia", "software", "linux"],
      "unique": true
    },
    "bird": {
      "type": "string"
    },
    "pillar": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer"
    }
  }
}
