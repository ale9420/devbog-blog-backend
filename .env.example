HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (sqlite for dev and staging, postgres for production)
DATABASE_CLIENT=sqlite
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_FILENAME=.tmp/data.db
DATABASE_SSL=false
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# Admin flags
FLAG_NPS=true
FLAG_PROMOTE_EE=true

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BASE_URL=https://resources.bogdev.com.co

# Email (accounts: confirmation and password reset). Without SMTP_HOST no email is
# delivered. FRONTEND_URL builds the links in those emails. See docs/ACCOUNTS.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BogDev <no-reply@bogdev.com.co>"
FRONTEND_URL=https://bogdev.com.co
# Article URL on the frontend, for Umami paths and federated links
# FRONTEND_ARTICLE_PATH=/blog/{slug}
# FRONTEND_DEFAULT_LOCALE=en

# Fediverse (ActivityPub). Off by default; see docs/FEDIVERSE.md and docs/CI_CD.md
FEDIVERSE_ENABLED=false
# FEDIVERSE_ACTOR_USERNAME=bogdev      # @user of the handle, safe to change
# FEDIVERSE_ACTOR_IDENTIFIER=devbog    # actor URI path, never change it once federated
# FEDIVERSE_ACTOR_NAME=                # fallbacks when Global settings are empty
# FEDIVERSE_ACTOR_SUMMARY=
# FEDIVERSE_ACTOR_SOURCE_URL=

# Disables every cron task (e.g. the Umami sync)
# STRAPI_DISABLE_CRON=false

# Umami analytics (optional). Internal URL, website id and the API key of a View only
# user; the most read articles endpoint stays empty without them. See docs/ANALYTICS.md
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
# UMAMI_SYNC_CRON=0 * * * *
# UMAMI_PUBLIC_URL=https://analytics.bogdev.com.co

# Browser origins allowed by CORS, comma separated. Unset allows any origin;
# production should list only the frontend. See docs/CI_CD.md
# CORS_ORIGINS=https://bogdev.com.co

# Strapi MCP Server (requires Strapi 5.47.0+): /mcp is on unless
# STRAPI_MCP_ENABLED=false (config/server.ts). Clients authenticate with a Strapi
# Admin API token (Admin panel -> Settings -> Admin API Tokens). The MCP entry in
# .mcp.json reads the token from ~/.claude/secrets/strapi-mcp-admin-token

# Docker volumes (named volumes for persistent storage)
# Volume names: <COMPOSE_PROJECT>_strapi-tmp, <COMPOSE_PROJECT>_strapi-db-data
COMPOSE_PROJECT=devbog-blog-backend

# Backup / restore
BACKUP_DIR=/backups/devbog
RETENTION_DAYS=14
