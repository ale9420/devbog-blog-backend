HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (sqlite for dev, postgres/mysql for production)
DATABASE_CLIENT=sqlite
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_FILENAME=.tmp/data.db
DATABASE_SSL=false
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# Admin flags
FLAG_NPS=true
FLAG_PROMOTE_EE=true

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_BASE_URL=https://resources.bogdev.com.co

# Strapi MCP Server (requires Strapi 5.47.0+)
STRAPI_MCP_URL=http://localhost:1337
STRAPI_MCP_ADMIN_TOKEN=

# Docker volumes (named volumes for persistent storage)
# Volume names: <COMPOSE_PROJECT>_strapi-tmp, <COMPOSE_PROJECT>_strapi-db-data
COMPOSE_PROJECT=devbog-blog-backend

# Backup / restore
BACKUP_DIR=/backups/devbog
RETENTION_DAYS=14
