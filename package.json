{
  "name": "devbog-blog-backend",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "build:fediverse": "esbuild src/plugins/fediverse/server/src/index.ts --bundle --packages=external --platform=node --format=cjs --outfile=src/plugins/fediverse/dist/strapi-server.js",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "generate:keys": "node ./scripts/generate-keys.js",
    "seed:example": "node ./scripts/seed.js",
    "prestart": "node -e \"require('fs').mkdirSync('public/uploads', { recursive: true })\"",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "typecheck": "tsc --noEmit && tsc --project src/plugins/fediverse/tsconfig.json && tsc --project tests/tsconfig.json",
    "prebuild": "npm run build:fediverse",
    "predev": "npm run build:fediverse",
    "predevelop": "npm run build:fediverse",
    "pretest": "npm run build:fediverse",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@fedify/fedify": "2.3.9",
    "@fedify/koa": "2.3.9",
    "@js-temporal/polyfill": "^0.5.1",
    "@notum-cz/strapi-plugin-seo": "^2.0.12",
    "@strapi/i18n": "^5.56.0",
    "@strapi/plugin-users-permissions": "^5.56.0",
    "@strapi/provider-email-nodemailer": "^5.56.0",
    "@strapi/provider-upload-aws-s3": "^5.56.0",
    "@strapi/strapi": "^5.56.0",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "strapi-plugin-comments": "^3.2.4",
    "styled-components": "^6.3.12"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "12.11.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.8.4",
    "supertest": "^7.3.0",
    "typescript": "^5",
    "typescript-eslint": "^8.61.1"
  },
  "engines": {
    "node": ">=20.19.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "c8f9eb3b-3208-4a3d-b35a-944b4dde5743",
    "installId": "964b072232ae06acbf76e84e14c792edb72cb22d44ea04c713df924ad2c47907"
  },
  "overrides": {
    "axios": "^1.20.0",
    "nodemailer": "^9.1.1",
    "postcss": "^8.5.28",
    "markdown-it": "^14.3.2",
    "dompurify": "^3.4.16",
    "@opentelemetry/core": "^2.8.0"
  }
}
